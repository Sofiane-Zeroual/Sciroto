
/* EXERCICE 4 */

/* Badge Nouveau */
.image-livre {
    position: relative;
    display: inline-block;
}

.badge-nouveau {
    position: absolute;
    top: 10px;
    right: 10px;
    background-color: lightgreen;
    color: black;
    padding: 5px 10px;
    border-radius: 10px;
}

/* style des états des liens et des boutons */
nav a:hover, nav a:focus {
    color: lightgreen;
    text-decoration: underline;
}

/* Champs du formulaire */
input:focus, textarea:focus {
    border: 2px solid green;
    outline: none;
}

/* Boutons */
button:hover, input[type="submit"]:hover {
    background-color: lightgreen;
    color: black;
    cursor: pointer;
}

/* Décoration des titres */
h2::after {
    content: "";
    display: block;
    width: 40px;
    height: 4px;
    background-color: lightgreen;
    margin-top: 5px;
}
